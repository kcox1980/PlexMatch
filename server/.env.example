# Copy this file to .env and fill in your own Plex server details.
# PLEX_URL is your Plex server's local address, e.g. http://192.168.1.50:32400
PLEX_URL=
# PLEX_TOKEN is your Plex account's X-Plex-Token.
# Find it: open any item in Plex Web, click "Get Info" -> "View XML", the token is in the URL.
PLEX_TOKEN=

# Port the PlexMatch API server listens on.
PORT=4100

# Comma-separated Plex library section titles to include (e.g. "Movies,TV Shows").
# Leave blank to include all movie/show libraries.
PLEX_LIBRARIES=
